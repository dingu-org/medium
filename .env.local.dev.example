# Meta TEST app credentials for local Embedded Signup over an HTTPS tunnel.
# Copy to .env.local.dev (git-ignored) and fill with your Meta *test* app values.
# These override .env.local when you run the dev server for WhatsApp E2E.
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# META_REDIRECT_URI=https://<name>.trycloudflare.com/api/auth/meta-embedded
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
# NEXT_PUBLIC_APP_URL=https://<name>.trycloudflare.com
