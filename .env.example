# The one local env file — the development environment.
#
# Everything local reads this: `pnpm dev` (Next auto-loads `.env`), vitest,
# the seed/smoke/db scripts, drizzle. Fresh clone: `cp .env.example .env` and
# it works as-is — every value below is the deterministic local Supabase
# stack (`supabase start`), safe to keep on disk.
#
# Development never touches a deployed database: the boot guard
# (lib/env/guard.ts) refuses to start against one. Deployed credentials live
# only in the git-ignored pulled files (.env.vercel.preview /
# .env.vercel.production via `pnpm env:pull:*`), used by the db:migrate:* and
# seed:*:preview scripts. See docs/environments.md.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fake Meta credentials — development has no Meta app of its own. For local
# WhatsApp E2E, borrow Preview's test app over a tunnel: see the borrow block
# at the bottom.
META_APP_ID=test-app-id
META_APP_SECRET=test-app-secret
META_WEBHOOK_VERIFY_TOKEN=test-verify-token

# Free model only in development. Set a real key to exercise AI turns locally;
# pnpm ai:smoke hard-guards to :free models either way.
OPENROUTER_API_KEY=test
OPENROUTER_DEV_MODEL=nex-agi/nex-n2-pro:free
OPENROUTER_PROD_MODEL=openai/gpt-4.1-mini
OPENROUTER_MODEL_OVERRIDE=

# Local Inngest Dev Server (`npx inngest-cli dev`) — no cloud environment.
INNGEST_EVENT_KEY=dev

TOKEN_ENCRYPTION_KEY=dev-test-key-32-bytes-base64-padding====

# Throwaway VAPID keypair (never used against a real push service).
VAPID_SUBJECT=mailto:test@example.com
VAPID_PUBLIC_KEY=BPeDSgpXj8ulxoSNfwWBS6etDS7F2dK1CCV0mI2xjR0lDEnZvQUhm0l-fs0NFzxgj4d2FxLkkN_iU82DqN0cu3w
VAPID_PRIVATE_KEY=MssfZ8c_3WlKEIKMwwv0TSLA1pnDczY-JB0NSSUBJi0

# Uncomment to view /admin locally (must match the email you sign in with).
# ADMIN_EMAILS=qa@medium.local

# POK payments — staging, optional locally; unset just disables the checkout
# smoke (pnpm smoke:pok). Never put production POK credentials here.
POK_ENV=staging
# POK_MERCHANT_ID=
# POK_KEY_ID=
# POK_KEY_SECRET=

# --- Meta test-app borrow (local WhatsApp E2E over a tunnel) ---------------
# The test app BELONGS TO PREVIEW. Borrowing it is the one sanctioned
# cross-environment exception (CONTEXT.md "Borrow"): run `pnpm tunnel`, point
# the test app's webhook + Embedded Signup redirect at the printed
# trycloudflare.com URL, fill + uncomment below (later values win over the
# fake ones above), and WHEN DONE point the webhook back at
# medium-preview.dingu.org — preview's WhatsApp is broken until you do.
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# META_REDIRECT_URI=https://<name>.trycloudflare.com/api/auth/meta-embedded
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
# NEXT_PUBLIC_APP_URL=https://<name>.trycloudflare.com
