# Environment variable contract — three environments, three value sets.
#
# The machine-readable contract lives in lib/env/env-vars.ts (which variables
# are required where, which must differ between Preview and Production); the
# operational runbook is docs/environments.md. Verify with:
#
#   pnpm check:env          # the environment this process runs in
#   pnpm check:env:vercel   # the Vercel project's per-target entries
#
# Development is configured by .env.local (local Supabase stack — see the
# committed defaults there). Deployed values are entered in Vercel per
# environment, never shared between Preview and Production, and pulled locally
# only as git-ignored files (pnpm env:pull:preview / env:pull:prod).

# --- identity (set implicitly: VERCEL_ENV on deploys, default development) ---
# APP_ENV=                # explicit override: development | preview | production
# ALLOW_ENV_MISMATCH=     # =1 downgrades the boot guard to a warning; for
#                         # deliberate cross-env ops only. Seeding ignores it.

# --- database (per environment: local stack / preview project / prod project)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- app ---
NEXT_PUBLIC_APP_URL=
TOKEN_ENCRYPTION_KEY=      # per environment; rotating orphans stored tokens
ADMIN_EMAILS=              # optional; unset disables /admin (404)

# --- WhatsApp / Meta (prod = live app; preview = test app; dev = fake) ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=
NEXT_PUBLIC_META_APP_ID=   # mirrors META_APP_ID for the Embedded Signup SDK
NEXT_PUBLIC_META_CONFIG_ID=

# --- AI (one shared OpenRouter key; model choice keyed on the environment) ---
OPENROUTER_API_KEY=
OPENROUTER_DEV_MODEL=nex-agi/nex-n2-pro:free
OPENROUTER_PROD_MODEL=openai/gpt-4.1-mini
OPENROUTER_MODEL_OVERRIDE=

# --- background jobs (per Inngest environment; dev uses the local Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=       # deployed environments only

# --- web push (per environment; subscriptions bind to the keypair) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:klaididingu@gmail.com

# --- payments (POK staging in dev+preview, production in prod) ---
POK_ENV=staging
POK_MERCHANT_ID=
POK_KEY_ID=
POK_KEY_SECRET=
